{
  "method": "wapirl",
  "seed": 2026,
  "data_file": "../data/wm38k/Wafer_Map_Datasets.npz",
  "split_file": "protocol/deduplicated/split.csv",
  "retrieval_protocol_dir": "protocol/retrieval_v1",
  "output_dir": "artifacts/wapirl_f_aligned_v1",
  "expected_classes": 37,
  "device": "cuda",
  "num_workers": 4,
  "torch_threads": 4,
  "batch_size": 256,
  "inference_batch_size": 256,
  "input_size": 96,
  "embedding_dim": 512,
  "augmentation": {
    "rotation": true
  },
  "local": {
    "epochs": 100,
    "learning_rate": 0.01,
    "weight_decay": 0.001,
    "projector_dim": 128,
    "temperature": 0.07,
    "num_negatives": 5000,
    "memory_momentum": 0.5,
    "optimizer": "sgd",
    "momentum": 0.9,
    "scheduler": "wapirl_cosine",
    "early_stopping": {
      "enabled": false
    },
    "projector_type": "linear",
    "negative_sampling": "with_replacement",
    "opening": {
      "enabled": false
    }
  },
  "parameters": {
    "input_channels": 3,
    "stem_stride": 1,
    "score": "clipped_cosine",
    "preprocess": "whole_wafer_nearest",
    "channels": [
      "defect",
      "defect",
      "valid_wafer"
    ]
  },
  "selection": "minimum_valid_nce"
}
